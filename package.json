{
  "name": "zero-vue",
  "type": "module",
  "version": "0.8.1",
  "packageManager": "pnpm@11.23.0",
  "description": "",
  "license": "MIT",
  "repository": "danielroe/zero-vue",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vitest dev",
    "lint": "eslint .",
    "prepare": "simple-git-hooks",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm lint && pnpm test",
    "test": "pnpm test:unit && pnpm test:types && pnpm test:e2e",
    "test:e2e": "pnpm -r --workspace-concurrency=1 test:e2e",
    "test:unit": "vitest run",
    "test:types": "tsc --noEmit && pnpm -r test:types"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  },
  "dependencies": {
    "@rocicorp/zero": "^1.9.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@rocicorp/resolver": "1.0.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "installed-check": "11.0.0",
    "knip": "6.32.2",
    "nano-staged": "1.0.2",
    "pg": "8.23.0",
    "playwright-core": "1.62.1",
    "simple-git-hooks": "2.13.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "vue": "3.5.41",
    "zod": "4.4.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,json,.*rc}": [
      "npx eslint --fix"
    ]
  }
}
